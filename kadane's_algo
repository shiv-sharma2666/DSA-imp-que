class Solution {
public:
    int maximumSum(vector<int>& arr) {
        int onedelete=INT_MIN;
        int nodelete=arr[0];
        int res=arr[0];
        int v1;
        for(int i=1;i<arr.size();i++){
            int prev=nodelete;
            nodelete=max(prev+arr[i],arr[i]);
            if(onedelete==INT_MIN){
                v1=prev;
            }
            else{
                v1=onedelete+arr[i];
            }
            onedelete=max(v1,prev);
        
            res = max(res,max(onedelete,nodelete));
        }
        return res;

        
    }
};