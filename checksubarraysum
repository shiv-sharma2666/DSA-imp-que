 bool checkSubarraySum(vector<int>& nums, int k) {
        unordered_map<int ,int> freq;
        int sum=0;
        //int res=0;
        freq[0]=-1;
        for(int i=0;i<nums.size();i++){
            sum+=nums[i];
            int rem=sum%k;
            //freq[rem]=i;
            if(freq.count(rem)){
                if(i-freq[rem]>=2)return true;
            }
            else{
            freq[rem]=i;}


        }
        return false;
        
    }
};